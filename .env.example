# ============================================================
#  중고타운 (SafeDeal Town) 환경설정 예시
#  복사:  cp .env.example .env   (Windows: copy .env.example .env)
#  비워두면 전부 안전한 기본값으로 동작합니다 (키 없이 바로 플레이 가능).
# ============================================================

# ---------- AI 모드 ----------
# mock         : API 키 없이 내장 시나리오로 NPC가 말함 (기본값)
# openai       : OpenAI 호환 API 호출 (OPENAI_API_KEY 필요)
# local_claude : 내 PC 의 Claude Code/호환 CLI 를 subprocess 로 호출 (개인 로컬용)
AI_MODE=mock

# ---------- OpenAI (AI_MODE=openai 일 때만) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# ---------- 로컬 Claude Code 어댑터 (AI_MODE=local_claude 일 때만) ----------
# 본인 환경의 CLI 에 맞게 설정하세요. 프롬프트는 기본적으로 stdin 으로 전달됩니다.
# Claude Code CLI 권장 설정: 비대화형(print) 모드로 stdin 프롬프트에 한 번 답하게 한다.
#   CLAUDE_CODE_ARGS=-p
# (CLAUDE_CODE_ARGS 안에 "{prompt}" 자리표시자를 넣으면 stdin 대신 인자로 전달됩니다.)
# 실패/타임아웃/명령없음 시 자동으로 mock 으로 폴백하므로 게임은 멈추지 않습니다.
# NPC 한 마디당 CLI 한 번 호출 → 대략 수 초 지연 + 본인 Claude 사용량이 소모됩니다.
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_ARGS=-p
CLAUDE_CODE_TIMEOUT_SECONDS=40

# ---------- NPC 난이도별 모델 (AI_MODE=local_claude 일 때만 적용) ----------
# 어려운 NPC 일수록 더 강한 모델로 더 정교하게 사람을 속입니다.
#   easy   → 빠르고 가벼운 모델 (haiku)
#   medium → 균형 모델 (sonnet)
#   hard   → 가장 정교한 모델 (opus 4.8) — 노련한 사기꾼/진상 구매자
#   judge  → 채점·코칭용 (가벼운 모델로 충분)
# 정확한 ID 대신 별칭 "haiku" / "sonnet" / "opus" 도 CLI 가 인식합니다.
# 값을 비우거나 줄을 지우면 config.py 의 기본값(아래와 동일)을 씁니다.
# 이 설정은 local_claude 모드 전용입니다. mock(기본)/openai 모드에서는 무시됩니다.
CLAUDE_MODEL_EASY=claude-haiku-4-5-20251001
CLAUDE_MODEL_MEDIUM=claude-sonnet-4-6
CLAUDE_MODEL_HARD=claude-opus-4-8
CLAUDE_MODEL_JUDGE=claude-haiku-4-5-20251001

# ---------- 맵 제공자 ----------
# procedural : 키 없이 시드 기반 절차적 동네 생성 (기본값, 항상 동작)
# google     : GOOGLE_MAPS_API_KEY 필요 (없으면 procedural 로 폴백)
# naver      : NAVER_MAP_CLIENT_ID/SECRET 필요 (없으면 procedural 로 폴백)
# * 어떤 경우에도 캔버스는 도트/픽셀 스타일 동네로 그려집니다.
# * 동네는 접속 위치(IP, 무키 추정)로 자동 시드/명명됩니다. 키 없이도 동작하며,
#   네트워크가 막혀도 절차적 맵으로 그냥 진행합니다(정밀 위치는 저장 안 함).
#   더 정확히 맞추려면 셋업 화면의 위치 동의 체크박스를 켜세요(브라우저 지오로케이션).
MAP_PROVIDER=procedural
GOOGLE_MAPS_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ---------- 시장 데이터 제공자 (동적 매물/NPC 생성) ----------
# 게임의 NPC 매물은 고정이 아니라 카테고리별로 매번 다르게 생성됩니다.
# 그 '시장 맥락'을 어디서 가져올지 고릅니다. 기본값으로 키 없이 항상 동작합니다.
#
#   synthetic     : 내장 카탈로그로 합성 (기본값, 오프라인 항상 동작)
#   manual_import : 개발자가 둔 안전한 CSV/JSON 을 위생처리해서 사용
#   trend_cache   : 비식별·집계된 시장 트렌드 캐시 기반 생성
#   official_stub : (미구현) 공식 API 자리표시자 — 실제 호출/스크래핑 없음
#                   ALLOW_EXPERIMENTAL_MARKET_PROVIDERS=true 일 때만 선택 가능(그래도 외부호출 안 함)
#
# ⚠️ 안전/법적 경계: 당근/번개장터 등 실서비스 스크래핑·크롤링·로그인 자동화는 절대 하지 않습니다.
#    실제 게시글 원문/이미지/사용자명/연락처/정확한 주소/계좌번호를 복제·표시하지 않습니다.
#    수동 import 데이터는 normalizer 가 개인정보를 모두 제거한 뒤에만 사용됩니다.
#    선택한 제공자가 실패하면 자동으로 synthetic 으로 폴백합니다.
MARKET_LISTING_PROVIDER=synthetic
MARKET_IMPORT_PATH=runtime/imports/market_listings.json
MARKET_TREND_CACHE_PATH=runtime/market_trends.json
ALLOW_EXPERIMENTAL_MARKET_PROVIDERS=false

# ---------- 적응형 시나리오 엔진 (방어 훈련 커리큘럼) ----------
# 완료된 거래마다 '어떤 위험 신호를 잘/못 다뤘는지'를 구조화해 저장하고,
# 다음 세션에서 약한 신호를 더 자주, 숙달·최근 반복된 신호는 덜 등장시킵니다.
# ⚠️ 이것은 '방어 훈련'입니다. 실제 사기 수법/링크/결제절차를 생성하지 않습니다.
#
#   ADAPTIVE_SCENARIOS_ENABLED   : false 면 게임이 '이전과 완전히 동일'하게 동작 (적응 OFF)
#   STORE_REDACTED_TRANSCRIPTS   : 기본 false. 원문 대화는 저장하지 않고 '비식별 후'에만 옵트인 저장
#   PERSONA_EVOLUTION_PROVIDER   : template(기본·항상안전) | local_claude | openai
#                                  (local_claude/openai 실패 시 자동으로 template 폴백)
#   ADAPTIVE_MIN_HISTORY_...      : 이 횟수만큼 완료해야 개인화 시작 (그 전엔 균형 기본 시나리오)
#   ADAPTIVE_RECENT_AVOID_...     : 숙달한 신호를 며칠 동안 덜 등장시킬지 (지루한 반복 방지)
#   ADAPTIVE_DEBUG_EXPLAIN        : 기본 false. true 여도 '결과 화면 이후'에만 선택 사유를 노출
ADAPTIVE_SCENARIOS_ENABLED=true
STORE_REDACTED_TRANSCRIPTS=false
PERSONA_EVOLUTION_PROVIDER=template
ADAPTIVE_MIN_HISTORY_FOR_PERSONALIZATION=3
ADAPTIVE_RECENT_AVOID_WINDOW_DAYS=7
ADAPTIVE_DEBUG_EXPLAIN=false

# ---------- 동적 페르소나 생성 (스폰 시점) ----------
# NPC 가 등장할 때마다 '겉모습/성격/말투/배경/문의 문구'를 더 다양하게 만든다.
# 위 PERSONA_EVOLUTION_PROVIDER(세션 시작 시 표면 변주)와는 '별개의 레이어'다.
#   template     : 내장 템플릿만 사용 (기본값, 항상 안전/오프라인)
#   local_claude : 로컬 CLI 로 매번 다른 페르소나 JSON 을 생성 (AI_MODE=local_claude 필요)
#   openai       : OpenAI 호환 API 로 생성 (AI_MODE=openai + 키 필요)
# ⚠️ local_claude/openai 라도 생성·검증 실패 시 자동으로 template 로 폴백 → 게임은 안 멈춤.
#    생성물은 엄격히 검증/위생처리되며, 실제 URL·계좌·전화·결제링크 등은 절대 만들지 않는다.
# AI_MODE 가 mock(기본)이면 이 값과 무관하게 항상 template 로 동작한다(두 단계 게이트).
DYNAMIC_PERSONA_PROVIDER=template
DYNAMIC_PERSONA_CACHE=true
DYNAMIC_PERSONA_CACHE_TTL_MINUTES=120

# ---------- 상품 카탈로그 신선도 ----------
# 0(기본)이면 서버의 현재 연도를 기준으로 모델 연식을 생성한다. 특정 연도로 고정하려면 값을 지정.
CURRENT_MARKET_YEAR=0

# ---------- 판매자 모드 인바운드 문의 페이싱 ----------
# 판매글을 올리면 구매자 NPC 들이 '하나둘' 문의를 보낸다. 한꺼번에 몰리지 않도록 페이싱한다.
#   SELLER_INQUIRY_MIN/MAX_DELAY_SECONDS : 새 문의 사이의 무작위 간격(초)
#   SELLER_MAX_PENDING_INQUIRIES         : 동시에 대기 중인 문의 카드 최대 수
#   SELLER_MAX_APPROACHING_BUYERS        : 한 번에 다가오는 구매자 최대 수
SELLER_INQUIRY_MIN_DELAY_SECONDS=15
SELLER_INQUIRY_MAX_DELAY_SECONDS=45
SELLER_MAX_PENDING_INQUIRIES=3
SELLER_MAX_APPROACHING_BUYERS=2

# ---------- 방어 훈련 플랫폼 레이어 (진단/리포트/커뮤니티/시나리오/기관) ----------
# 이 레이어는 게임 위에 얹히는 '개인맞춤형 사기 방어 훈련·진단' 기능이다.
#   COMMUNITY_CASES_ENABLED            : 피해 사례 공유(커뮤니티 MVP) on/off. 끄면 관련 API 가 404.
#   ORG_DEMO_DASHBOARD_ENABLED         : 기관/코호트 데모 대시보드 on/off. 끄면 관련 API 가 404.
#   CASE_SCENARIO_GENERATOR_PROVIDER   : 비식별 사례 → 픽션화된 방어 시나리오 변환 제공자
#       template     : 규칙/템플릿 기반 (기본값·항상 안전·오프라인). 원문 사례를 복제하지 않는다.
#       local_claude : 로컬 CLI 로 초안 생성 (검증 실패/타임아웃 시 template 폴백)
#       openai       : OpenAI 호환 API 로 초안 생성 (검증 실패 시 template 폴백)
#     * 어떤 제공자든 생성물은 검증기를 통과해야 하며, 실제 개인정보/실행 가능한 사기 절차는 생성하지 않는다.
#   CASE_SCENARIO_REQUIRES_REVIEW      : true(기본)면 생성 시나리오는 'draft/pending_review' 로만 저장되고,
#     approved 로 승격돼야 훈련에 쓰인다 (사람 검토 게이트).
COMMUNITY_CASES_ENABLED=true
ORG_DEMO_DASHBOARD_ENABLED=true
CASE_SCENARIO_GENERATOR_PROVIDER=template
CASE_SCENARIO_REQUIRES_REVIEW=true

# ---------- 서버 ----------
HOST=0.0.0.0
PORT=8000

# ---------- 보안 (운영 시 반드시 바꾸세요) ----------
JWT_SECRET=dev-insecure-secret-change-me
PASSWORD_PEPPER=dev-insecure-pepper-change-me
TOKEN_TTL_MINUTES=720

# ---------- DB ----------
DATABASE_PATH=runtime/safedeal_town.sqlite3
