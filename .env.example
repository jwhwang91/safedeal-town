# ============================================================
#  중고타운 (SafeDeal Town) 환경설정 예시
#  복사:  cp .env.example .env   (Windows: copy .env.example .env)
#  비워두면 전부 안전한 기본값으로 동작합니다 (키 없이 바로 플레이 가능).
# ============================================================

# ---------- AI 모드 ----------
# mock         : API 키 없이 내장 시나리오로 NPC가 말함 (기본값)
# openai       : OpenAI 호환 API 호출 (OPENAI_API_KEY 필요)
# local_claude : 내 PC 의 Claude Code/호환 CLI 를 subprocess 로 호출 (개인 로컬용)
AI_MODE=mock

# ---------- OpenAI (AI_MODE=openai 일 때만) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# ---------- 로컬 Claude Code 어댑터 (AI_MODE=local_claude 일 때만) ----------
# 본인 환경의 CLI 에 맞게 설정하세요. 프롬프트는 기본적으로 stdin 으로 전달됩니다.
# Claude Code CLI 권장 설정: 비대화형(print) 모드로 stdin 프롬프트에 한 번 답하게 한다.
#   CLAUDE_CODE_ARGS=-p
# (CLAUDE_CODE_ARGS 안에 "{prompt}" 자리표시자를 넣으면 stdin 대신 인자로 전달됩니다.)
# 실패/타임아웃/명령없음 시 자동으로 mock 으로 폴백하므로 게임은 멈추지 않습니다.
# NPC 한 마디당 CLI 한 번 호출 → 대략 수 초 지연 + 본인 Claude 사용량이 소모됩니다.
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_ARGS=-p
CLAUDE_CODE_TIMEOUT_SECONDS=40

# ---------- NPC 난이도별 모델 (AI_MODE=local_claude 일 때만 적용) ----------
# 어려운 NPC 일수록 더 강한 모델로 더 정교하게 사람을 속입니다.
#   easy   → 빠르고 가벼운 모델 (haiku)
#   medium → 균형 모델 (sonnet)
#   hard   → 가장 정교한 모델 (opus 4.8) — 노련한 사기꾼/진상 구매자
#   judge  → 채점·코칭용 (가벼운 모델로 충분)
# 정확한 ID 대신 별칭 "haiku" / "sonnet" / "opus" 도 CLI 가 인식합니다.
# 값을 비우거나 줄을 지우면 config.py 의 기본값(아래와 동일)을 씁니다.
# 이 설정은 local_claude 모드 전용입니다. mock(기본)/openai 모드에서는 무시됩니다.
CLAUDE_MODEL_EASY=claude-haiku-4-5-20251001
CLAUDE_MODEL_MEDIUM=claude-sonnet-4-6
CLAUDE_MODEL_HARD=claude-opus-4-8
CLAUDE_MODEL_JUDGE=claude-haiku-4-5-20251001

# ---------- 맵 제공자 ----------
# procedural : 키 없이 시드 기반 절차적 동네 생성 (기본값, 항상 동작)
# google     : GOOGLE_MAPS_API_KEY 필요 (없으면 procedural 로 폴백)
# naver      : NAVER_MAP_CLIENT_ID/SECRET 필요 (없으면 procedural 로 폴백)
# * 어떤 경우에도 캔버스는 도트/픽셀 스타일 동네로 그려집니다.
# * 동네는 접속 위치(IP, 무키 추정)로 자동 시드/명명됩니다. 키 없이도 동작하며,
#   네트워크가 막혀도 절차적 맵으로 그냥 진행합니다(정밀 위치는 저장 안 함).
#   더 정확히 맞추려면 셋업 화면의 위치 동의 체크박스를 켜세요(브라우저 지오로케이션).
MAP_PROVIDER=procedural
GOOGLE_MAPS_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ---------- 시장 데이터 제공자 (동적 매물/NPC 생성) ----------
# 게임의 NPC 매물은 고정이 아니라 카테고리별로 매번 다르게 생성됩니다.
# 그 '시장 맥락'을 어디서 가져올지 고릅니다. 기본값으로 키 없이 항상 동작합니다.
#
#   synthetic     : 내장 카탈로그로 합성 (기본값, 오프라인 항상 동작)
#   manual_import : 개발자가 둔 안전한 CSV/JSON 을 위생처리해서 사용
#   trend_cache   : 비식별·집계된 시장 트렌드 캐시 기반 생성
#   official_stub : (미구현) 공식 API 자리표시자 — 실제 호출/스크래핑 없음
#                   ALLOW_EXPERIMENTAL_MARKET_PROVIDERS=true 일 때만 선택 가능(그래도 외부호출 안 함)
#
# ⚠️ 안전/법적 경계: 당근/번개장터 등 실서비스 스크래핑·크롤링·로그인 자동화는 절대 하지 않습니다.
#    실제 게시글 원문/이미지/사용자명/연락처/정확한 주소/계좌번호를 복제·표시하지 않습니다.
#    수동 import 데이터는 normalizer 가 개인정보를 모두 제거한 뒤에만 사용됩니다.
#    선택한 제공자가 실패하면 자동으로 synthetic 으로 폴백합니다.
MARKET_LISTING_PROVIDER=synthetic
MARKET_IMPORT_PATH=runtime/imports/market_listings.json
MARKET_TREND_CACHE_PATH=runtime/market_trends.json
ALLOW_EXPERIMENTAL_MARKET_PROVIDERS=false

# ---------- 서버 ----------
HOST=0.0.0.0
PORT=8000

# ---------- 보안 (운영 시 반드시 바꾸세요) ----------
JWT_SECRET=dev-insecure-secret-change-me
PASSWORD_PEPPER=dev-insecure-pepper-change-me
TOKEN_TTL_MINUTES=720

# ---------- DB ----------
DATABASE_PATH=runtime/safedeal_town.sqlite3
